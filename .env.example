# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Hosted model providers (all free tier) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Not on the critical path — its free tier rate-limited too aggressively to
# depend on, so no role routes to it. Left here only if you want to re-add it.
GEMINI_API_KEY=

# --- Deployment modes (see docs/DEPLOY.md) ---
# Serve recorded runs only; live submission returns 503. No keys needed.
# This is what the public link runs, so nobody can spend your quota.
FAULTLINE_PUBLIC_DEMO=
# Remap the local Ollama roles onto hosted models, for hosts without a GPU.
FAULTLINE_HOSTED_ONLY=

# --- Demo narration (optional, scripts/capture_demo.ps1) ---
# The API key starts with sk_ and is shown once at creation — the value listed
# on the API Keys page is the key ID and will be rejected.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Local models ---
OLLAMA_HOST=http://localhost:11434

# --- Scholarly APIs (no key needed; email enables the polite pool) ---
# Sent in the User-Agent to OpenAlex / Crossref / Unpaywall for faster,
# more reliable service. Keep it out of committed code.
POLITE_POOL_EMAIL=

# Optional — raises Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# --- Guardrails ---
# Hard cap on hosted requests per run. A runaway loop must not burn the
# daily free-tier quota mid-demo.
MAX_HOSTED_REQUESTS_PER_RUN=1500
